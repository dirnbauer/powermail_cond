{
	"name": "in2code/powermail_cond",
	"description": "Add conditions (via AJAX) to powermail forms for fields and pages",
	"license": "GPL-2.0-or-later",
	"type": "typo3-cms-extension",
	"keywords": [
		"typo3",
		"form",
		"mailform",
		"spamprevention"
	],
	"authors": [
		{
			"name": "Alex Kellner",
			"email": "alexander.kellner@in2code.de",
			"homepage": "https://www.in2code.de",
			"role": "Product owner"
		},
		{
			"name": "Oliver Eglseder",
			"email": "oliver.eglseder@in2code.de",
			"homepage": "https://www.in2code.de",
			"role": "Developer"
		},
		{
			"name": "Webconsulting",
			"homepage": "https://github.com/dirnbauer",
			"role": "Maintainer of the TYPO3 v14 fork"
		}
	],
	"homepage": "https://github.com/dirnbauer/powermail_cond",
	"support": {
		"issues": "https://github.com/dirnbauer/powermail_cond/issues",
		"source": "https://github.com/dirnbauer/powermail_cond"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/dirnbauer/powermail.git"
		}
	],
	"require": {
		"php": "^8.4",
		"ext-json": "*",
		"ext-pdo": "*",
		"in2code/powermail": "^14.0",
		"psr/event-dispatcher": "^1.0",
		"typo3/cms-backend": "^14.3",
		"typo3/cms-core": "^14.3",
		"typo3/cms-extbase": "^14.3",
		"typo3/cms-fluid": "^14.3",
		"typo3/cms-frontend": "^14.3"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.65",
		"helmich/typo3-typoscript-lint": "^3.2",
		"phpstan/phpstan": "^2.2",
		"saschaegerer/phpstan-typo3": "^3.1"
	},
	"replace": {
		"typo3-ter/powermail-cond": "self.version"
	},
	"autoload": {
		"psr-4": {
			"In2code\\PowermailCond\\": "Classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		},
		"bin-dir": ".Build/bin",
		"vendor-dir": ".Build/vendor"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "powermail_cond",
			"web-dir": ".Build/public"
		}
	},
	"scripts": {
		"test:php:cs": "php-cs-fixer fix --dry-run --config=.project/tests/.php-cs-fixer.php --diff",
		"test:php:csfix": "php-cs-fixer fix --config=.project/tests/.php-cs-fixer.php --diff",
		"test:php:lint": "find *.php Classes Configuration -name '*.php' -print0 | xargs -0 -n 1 -P 4 php -l",
		"test:php:stan": "phpstan analyse",
		"test:ts:lint": "typoscript-lint -c .project/tests/typoscript-lint.yml --fail-on-warnings"
	}
}
