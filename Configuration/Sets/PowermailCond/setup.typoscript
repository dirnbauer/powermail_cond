page {
  includeJSFooter {
    powermailCond = EXT:powermail_cond/Resources/Public/JavaScript/PowermailCondition.js
    powermailCond.defer = 1
  }

  3132 = COA
  3132 {
    wrap = <script id="powermail_conditions_container"|></script>

    # Uri to send AJAX request
    10 = TEXT
    10 {
      noTrimWrap = | data-condition-uri="|"|
      typolink {
        parameter.data = page:uid
        additionalParams = &type=3132
        returnLast = url
        forceAbsoluteUrl = 1
      }
    }
  }
}

powermailCondition = PAGE
powermailCondition {
  typeNum = 3132
  config {
    disableAllHeaderCode = 1
    disablePrefixComment = 1
    admPanel = 0
    debug = 0
    additionalHeaders.10 {
      header = Content-type: application/json
      replace = 1
    }
  }

  10 = USER_INT
  10 {
    userFunc = TYPO3\CMS\Extbase\Core\Bootstrap->run
    extensionName = PowermailCond
    controller = Condition
    pluginName = Pi1
    features.requireCHashArgumentForActionArguments = 0
  }
}
